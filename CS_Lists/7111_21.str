#####################################
#  Sample contents and methodology  #
#####################################
	 
    ########################
    #  Sample description  #
    ########################

save_sample_1
   _Saveframe_category   sample

   _Sample_type          solid
   _Details             
;
13C/15N uniformly labelled       
microcrystalline ubiquitine
;

   loop_
      _Mol_label
      _Concentration_value
      _Concentration_value_units
      _Isotopic_labeling

      $human_ubiquitin . mM '[U-13C; U-15N]' 

   stop_

save_


save_sample_2
   _Saveframe_category   sample

   _Sample_type          solid
   _Details             
;
10% 13C/100% 15N labelled       
microcrystalline ubiquitine
;

   loop_
      _Mol_label
      _Concentration_value
      _Concentration_value_units
      _Isotopic_labeling

      $human_ubiquitin . mM '[U-10% 13C; U-100% 15N]' 

   stop_

save_


