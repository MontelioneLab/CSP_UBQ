   _Saveframe_category   experimental_source


   loop_
      _Mol_label
      _Production_method
      _Host_organism_name_common
      _Genus
      _Species
      _Strain
      _Vector_name

      $CaD_peptide 'chemical synthesis'      .                 . . . . 
      $CaM         'recombinant technology' 'Escherichia coli' . . . . 

   stop_

save_


