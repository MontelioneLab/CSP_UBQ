   _Entry.Title
;
1H and 15N chemical shift assignments of K63-linked di-ubiquitin with K63R mutation in the distal ubiquitin
;
   _Entry.Type                           macromolecule
   _Entry.Version_type                   original
   _Entry.Submission_date                2025-04-09
